{
  "name": "quran-audio",
  "version": "0.5.0",
  "description": "Download Quran MP3 recitations from the terminal with searchable surah and reciter pickers and multi-source fallback.",
  "type": "module",
  "bin": {
    "quran": "bin/quran.js"
  },
  "files": [
    "bin",
    "src",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/quran.js",
    "update-data": "node scripts/build-data.js"
  },
  "keywords": [
    "quran",
    "mp3",
    "cli",
    "download",
    "recitation"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0"
  },
  "author": "MHDN55",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MHDN55/quran-audio.git"
  },
  "homepage": "https://github.com/MHDN55/quran-audio#readme",
  "bugs": {
    "url": "https://github.com/MHDN55/quran-audio/issues"
  }
}
